# A Sentry auth token with the project:read and event:read scopes.
# Create one at https://sentry.io/settings/account/api/auth-tokens/
SENTRY_AUTH_TOKEN=

# Your Sentry organization slug, as it appears in Sentry URLs.
SENTRY_ORG=

# Region-specific API base URL. Defaults to https://sentry.io.
# Use https://us.sentry.io or https://de.sentry.io if your org is pinned to a region.
SENTRY_API_BASE_URL=https://sentry.io

# Optional. The numeric project id to open by default. Without it the dashboard uses the first
# project the organization returns. This is the numeric id, not the slug.
SENTRY_DEFAULT_PROJECT=

# Optional. A shared secret (16+ characters) gating access. Required in production unless
# ALLOW_UNAUTHENTICATED=true is set deliberately. Append ?access=<secret> once to obtain a cookie.
DASHBOARD_ACCESS_SECRET=

# Optional. Set to "true" to run a production build with no access gate. Only safe when bound to
# localhost behind a tunnel; the dashboard shows a permanent warning banner when this is on.
ALLOW_UNAUTHENTICATED=

# The agent panel runs your local Claude Code binary. There is no Claude token: it authenticates as
# whoever is logged in on this machine (`claude` then sign in), and reads Sentry over the Sentry MCP
# connector enabled in claude.ai settings. Both of these are optional overrides.
# CLAUDE_CLI_PATH=/home/you/.local/bin/claude
# CLAUDE_AGENT_MODEL=haiku
# CLAUDE_AGENT_EFFORT=low
